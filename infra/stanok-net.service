# stanok-net — S4 (SPEC-NETWORK-2026-10-09). The supervisor prepares this
# unit; the OPERATOR installs it:
#   sudo cp stanok/infra/stanok-net.{sh,service} /etc/systemd/system/  (or a
#   symlink) — adjust ExecStart to the actual checkout path first — then
#   sudo systemctl daemon-reload && sudo systemctl enable --now stanok-net.service
# The launcher's network_preflight (rc=16 before every worker start) is the
# runtime check that this unit is active.
[Unit]
Description=stanok-net bridge network + STANOK-NET iptables policy (model-only egress)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Absolute path — the operator's checkout location; keep in sync with the install.
ExecStart=/home/hermes/darkcast/stanok/infra/stanok-net.sh

[Install]
WantedBy=multi-user.target
