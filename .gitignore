# machine run artifacts (git clean -fdq does NOT touch them — they are outside git)
evidence/
.stanok-logs/
*.log
# environment and python
.venv/
__pycache__/
# R4: CLI staging dir prepared by setup.sh before `docker build` (not source)
.build-context/
# native-sandbox stub targets, pre-created by sandbox-run.sh (create-if-missing).
# They must exist so the inner bwrap binds in place instead of creating the
# mountpoint on the read-only repo. Empty dirs (.vscode/, .idea/,
# .claude/{skills,commands,agents}) are invisible to git and need no entry.
/.gitconfig
/.gitmodules
/.bashrc
/.bash_profile
/.zshrc
/.zprofile
/.profile
/.ripgreprc
/.mcp.json
/.claude/settings.json
/.claude/settings.local.json
