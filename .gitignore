# machine run artifacts (git clean -fdq does NOT touch them — they are outside git)
evidence/
.stanok-logs/
*.log
# environment and python
.venv/
__pycache__/
# R4: CLI staging dir prepared by setup.sh before `docker build` (not source)
.build-context/
# Environment dotfiles that must never be tracked: per-machine state, not
# repo content (a bind-mounted home or a stray editor dir must not leak
# into the tree the machine works in).
/.gitconfig
/.gitmodules
/.bashrc
/.bash_profile
/.zshrc
/.zprofile
/.profile
/.ripgreprc
/.mcp.json
/.claude/settings.json
/.claude/settings.local.json
