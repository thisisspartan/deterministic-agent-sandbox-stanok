#!/usr/bin/env bash
# commit-msg: TASK-ID gate (git-native, grok commit-msg analog).
# Rejects a commit without TASK-STANOK-CC-NNN in the message.
# The model does NOT commit (git-write is forbidden); only the operator commits,
# outside the sandbox.
# Four maintenance prefixes pass without a task ID: the supervisor's
# save-state commit (before a ticket launch), the clean-for-task commit
# (before a new ticket exists), the sync-skeleton infra commit, and the
# operator's harness-fix commit. Exact prefixes (trailing space required),
# not a wildcard — no path uses --no-verify, so this hook is the only
# enforcement and must actually enforce.
MSG_FILE="$1"
if ! grep -Eq 'TASK-STANOK-CC-[0-9]+|^chore: save state before |^chore: clean for new task |^chore: sync infra |^chore: harness ' "$MSG_FILE"; then
  echo "COMMIT REJECTED: commit message must contain TASK-STANOK-CC-NNN (or be a recognized maintenance commit)" >&2
  exit 1
fi
exit 0
