#!/usr/bin/env bash
# commit-msg: TASK-ID gate (git-native, grok commit-msg analog).
# Rejects a commit without TASK-STANOK-CC-NNN in the message.
# The model does NOT commit (git-write is forbidden); only root commits via stanok_commit.sh.
#
# KNOWN ISSUE (2026-08-24, operator decision deferred):
# symlink .git/hooks/commit-msg is a self-loop:
#   .git/hooks/commit-msg -> ../hooks/commit-msg
# Relative to .git/hooks/, the path ../hooks/ = .git/hooks/, i.e. the link points
# at itself; git cannot read it ("Too many levels of symbolic links"),
# the hook NEVER fires. The TASK-ID gate is effectively DISABLED: commits without
# TASK-STANOK-CC-NNN pass. The target path is probably supposed to be
# ../../hooks/commit-msg (repo root). Do not fix until the operator decides;
# until then, do not rely on this gate.
MSG_FILE="$1"
if ! grep -Eq 'TASK-STANOK-CC-[0-9]+' "$MSG_FILE"; then
  echo "COMMIT REJECTED: commit message must contain TASK-STANOK-CC-NNN" >&2
  exit 1
fi
exit 0
