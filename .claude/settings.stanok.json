{
  "env": {
    "ANTHROPIC_AUTH_TOKEN": "local-dummy",
    "ANTHROPIC_API_KEY": "",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_NONSTREAMING_FALLBACK": "1",
    "CLAUDE_CODE_MAX_RETRIES": "1",
    "BASH_MAX_OUTPUT_LENGTH": "8000",
    "CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION": "0",
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "16000",
    "MAX_MCP_OUTPUT_TOKENS": "12000",
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "20000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "95",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_ATTRIBUTION_HEADER": "0",
    "MAX_THINKING_TOKENS": "0",
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "1",
    "ENABLE_BETA_TRACING_DETAILED": "1",
    "BETA_TRACING_ENDPOINT": "http://localhost:8080/v1/private/otel",
    "OTEL_SERVICE_NAME": "stanok-machine",
    "OTEL_EXPORTER_OTLP_HEADERS": "projectName=stanok",
    "DISABLE_AUTOUPDATER": "1",
    "CLAUDE_CODE_DISABLE_ADVISOR_TOOL": "1",
    "CLAUDE_AGENT_SDK_MCP_NO_PREFIX": "1"
  },
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Grep",
      "Glob",
      "Bash"
    ],
    "deny": [
      "Read(.git/**)",
      "Read(hooks/**)",
      "Read(launcher/**)",
      "Read(.claude/**)",
      "Read(evidence/**)",
      "Edit(.git/**)",
      "Edit(hooks/**)",
      "Edit(launcher/**)",
      "Edit(.claude/**)",
      "Edit(evidence/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "enableWeakerNestedSandbox": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyWrite": [
        "../evidence",
        "../hooks",
        "../launcher",
        "../.claude"
      ],
      "denyRead": [
        "../hooks",
        "../launcher",
        "../evidence",
        "../.claude"
      ]
    },
    "network": {
      "allowedDomains": [
        "192.168.8.131",
        "localhost",
        "127.0.0.1",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "deb.debian.org",
        "security.debian.org"
      ]
    }
  }
}
