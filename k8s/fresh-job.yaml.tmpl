# P1 (SPEC-STANOK-K8S-RUNTIME-2026-10-10 §7/§9) — the fresh-check Job:
# the host's independent verifier, the mirror of sandbox.fresh_verify_argv
# (the same `run.sh list; run.sh test --all` pair, the same rc precedence).
# It runs on the transported tree + changes.patch in a Pod the worker never
# touched, with NO model endpoint and NO network (the stanok: fresh deny-all
# NetworkPolicy) — the verifier only.
apiVersion: batch/v1
kind: Job
metadata:
  name: stanok-fresh-{{JOB_NAME}}
  namespace: {{NAMESPACE}}
  labels:
    stanok: fresh
spec:
  backoffLimit: 0
  activeDeadlineSeconds: {{DEADLINE}}
  ttlSecondsAfterFinished: 300  # CC-230: auto-cleanup of finished Jobs
  template:
    metadata:
      labels:
        stanok: fresh
    spec:
      restartPolicy: Never
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: fresh
          image: {{IMAGE}}
          imagePullPolicy: IfNotPresent
          # CC-230: HOME/TMPDIR aligned with the worker's pod_runner redirect —
          # under readOnlyRootFilesystem the image default /home/stanok is
          # read-only; tests writing to ~/.cache need a writable HOME in the
          # emptyDir. The dirs are created by the args script below.
          env:
            - name: HOME
              value: /stanok-work/home
            - name: TMPDIR
              value: /stanok-work/tmp
          command: ["bash", "-c"]
          args:
            - |
              set -u
              mkdir -p /stanok-work/work /stanok-work/home /stanok-work/tmp
              base64 -d /stanok/transport/tree.tar.gz.b64 | tar -xz -C /stanok-work/work
              cd /stanok-work/work
              if [ -s /stanok/patch/changes.patch ]; then
                git apply /stanok/patch/changes.patch
              fi
              bash scripts/run.sh list; list_rc=$?
              bash scripts/run.sh test --all; test_rc=$?
              if [ "$list_rc" -ne 0 ]; then exit "$list_rc"; fi
              exit "$test_rc"
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true  # CC-229 (SPEC-READONLY-ROOT): the fresh
            # verifier unpacks the tree, applies the patch and runs tests ONLY in
            # the /stanok-work emptyDir.
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          # Disk bound (Package 1): same rule as the worker Job — the
          # ephemeral-storage limit counts the writable layer AND the
          # emptyDir AND /var/log/pods together, so it must NOT equal the
          # emptyDir sizeLimit (2Gi).
          resources:
            requests:
              ephemeral-storage: "1Gi"
            limits:
              ephemeral-storage: "4Gi"
          volumeMounts:
            - name: tree
              mountPath: /stanok/transport
              readOnly: true
            - name: patch
              mountPath: /stanok/patch
              readOnly: true
            - name: work
              mountPath: /stanok-work
      volumes:
        - name: tree
          configMap:
            name: {{CM_TREE}}
        - name: patch
          configMap:
            name: {{CM_PATCH}}
        - name: work
          emptyDir:
            sizeLimit: 2Gi
