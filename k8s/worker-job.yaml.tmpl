# P1 (SPEC-STANOK-K8S-RUNTIME-2026-10-10 §7/§9) — the worker Job template.
# Rendered by launcher/k8s.py ({{VARS}} substitution) and applied with
# `kubectl apply -f -`. Vanilla K8s (no k3s-specific fields). The Pod works
# on the TRANSPORTED copy under /stanok-work (emptyDir) — the live tree is
# never touched. Non-root + dropped capabilities + RuntimeDefault seccomp
# replace the bwrap sandbox (O3); the network boundary is the
# NetworkPolicy (stanok: worker). NO privileged anywhere.
apiVersion: batch/v1
kind: Job
metadata:
  name: {{JOB_NAME}}
  namespace: {{NAMESPACE}}
  labels:
    stanok: worker
spec:
  backoffLimit: 0
  activeDeadlineSeconds: {{DEADLINE}}
  ttlSecondsAfterFinished: 300  # CC-230: auto-cleanup of finished Jobs
  template:
    metadata:
      labels:
        stanok: worker
    spec:
      restartPolicy: Never
      # Runtime-class knob (CC-256): the DEFAULT is gvisor, rendered by
      # k8s._runtime_class(); STANOK_K8S_RUNTIME_CLASS=runc opts out -> the
      # line renders empty == RuntimeDefault (the pre-gVisor behavior).
      # An unknown class fails at preflight (_preflight_runtime_class).
      {{RUNTIME_CLASS}}
      automountServiceAccountToken: false
      securityContext:
        runAsNonRoot: true
        runAsUser: 10001
        runAsGroup: 10001
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: worker
          image: {{IMAGE}}
          imagePullPolicy: IfNotPresent
          command: ["/usr/bin/python3", "/stanok/runner/pod_runner.py"]
          env:
            - name: STANOK_LABEL
              value: "{{LABEL}}"
            - name: STANOK_NONCE
              value: "{{NONCE}}"
            - name: STANOK_SERVER_URL
              value: "{{SERVER_URL}}"
            - name: STANOK_OPIK_TRACE_URL
              value: "{{OPIK_TRACE_URL}}"
            - name: STANOK_MODEL
              value: "{{MODEL}}"
            - name: STANOK_START_COMMIT
              value: "{{START_COMMIT}}"
            - name: STANOK_LOG_DIR
              value: "/stanok-work/logs"
            - name: STANOK_POD_REPO
              value: "/stanok-work/repo"
            - name: CLAUDE_PROJECT_DIR
              value: "/stanok-work/repo"  # CC-236 (incident cc235): the CLI does
              # not export CLAUDE_PROJECT_DIR for hooks (cli.js 2.1.88, plugin
              # context only); the PreToolUse command in .claude/settings.json
              # references it — unset it expands to /.claude/hooks/... and every
              # tool call ends with a non-blocking hook error (exit 127),
              # killing the loop guard. Set at the Job level AND in pod_runner
              # AND in build_agent_env (belt: the value must be right before the
              # CLI starts).
            - name: STANOK_IN_POD
              value: "1"  # CC-232: Pod-only test guard — tests/** skip the
              # Pod-only invariants on the host (false reds), run them here.
            - name: PYTHONDONTWRITEBYTECODE
              value: "1"
          securityContext:
            runAsNonRoot: true
            allowPrivilegeEscalation: false
            readOnlyRootFilesystem: true  # CC-229 (SPEC-READONLY-ROOT).
            # CC-234 correction: the CC-229 claim "all Pod writes already go
            # to /stanok-work" was FALSE — the CLI's Bash tool hardcodes
            # mkdir (CLAUDE_CODE_TMPDIR||/tmp)/claude-<uid> (cli.js 2.1.88);
            # with a read-only /tmp every Bash call died ENOENT (traces
            # cc231/cc233). The /tmp emptyDir below + the renamed env var in
            # pod_runner.py close it; session.py self-checks the path before
            # the model starts (ENV-FAIL otherwise).
            capabilities:
              drop:
                - ALL
            seccompProfile:
              type: RuntimeDefault
          # Disk bound (Package 1, operator spec 2026-10-10): the Pod's
          # ephemeral-storage limit counts the writable container layer AND
          # the emptyDir AND /var/log/pods TOGETHER — so it must NOT equal
          # the emptyDir sizeLimit (2Gi): a limit equal to the volume size
          # would evict the Pod for using the volume it was given. requests
          # 1Gi / limits 4Gi leave headroom for the volume plus logs.
          # G1 (SPEC-HOSTSIDE-WORKFLOW-2026-10-14): CPU/RAM bounds. The node is
          # 2 CPU / 15Gi shared with k3s/supervisor/Opik: the CPU limit (1 core)
          # prevents node saturation (throttling, not a guarantee); the memory
          # limit bounds the container (OOM-kill instead of node-pressure
          # eviction of others). requests = expected typical usage (admission,
          # fair CPU share, eviction accounting). CPU request raised 250m->500m
          # (operator decision 2026-10-16) on two measured peaks from
          # resource_peaks (host-stamped summary.json): 244m (cc269-measure),
          # 288m (cc270-fire) — the request must cover the observed peak;
          # 500m keeps headroom and stays half the limit. Memory request
          # unchanged: measured peaks ~344Mi stay well under 1Gi.
          resources:
            requests:
              cpu: 500m
              memory: "1Gi"
              ephemeral-storage: "1Gi"
            limits:
              cpu: 1000m
              memory: "2Gi"
              ephemeral-storage: "4Gi"
          volumeMounts:
            - name: ticket
              mountPath: /stanok/ticket
              readOnly: true
            - name: tree
              mountPath: /stanok/transport
              readOnly: true
            - name: runner
              mountPath: /stanok/runner
              readOnly: true
            - name: work
              mountPath: /stanok-work
            - name: tmp-dir
              mountPath: /tmp  # CC-234: writable /tmp (see the correction
              # comment at readOnlyRootFilesystem above).
      volumes:
        - name: ticket
          configMap:
            name: {{CM_TICKET}}
        - name: tree
          configMap:
            name: {{CM_TREE}}
        - name: runner
          configMap:
            name: {{CM_RUNNER}}
        - name: work
          emptyDir:
            sizeLimit: 2Gi
        - name: tmp-dir
          emptyDir:
            sizeLimit: 512Mi  # CC-234 (operator spec 2026-10-11): the CLI's
            # Bash tool mkdirs (CLAUDE_CODE_TMPDIR||/tmp)/claude-<uid>; with a
            # read-only /tmp every call died ENOENT (traces cc231/cc233).
